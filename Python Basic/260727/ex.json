    "author": "Gemini Assistant",
    "file_format": "JSON"
  },
  "supported_data_types": {
    "string": {
      "description": "문자열 (String)",
      "example": "반드시 큰따옴표(\"\")로 감싸야 합니다.",
      "value": "안녕하세요, JSON입니다!"
    },
    "number_integer": {
      "description": "정수형 숫자 (Integer)",
      "example": "따옴표 없이 숫자를 적습니다.",
      "value": 2026
    },
    "number_float": {
      "description": "실수형 숫자 (Float)",
      "example": "소수점을 포함할 수 있습니다.",
      "value": 98.6
    },
    "boolean_true": {
      "description": "불리언 참 (Boolean True)",
      "example": "소문자로 true 작성",
      "value": true
    },
    "boolean_false": {
      "description": "불리언 거짓 (Boolean False)",
      "example": "소문자로 false 작성",
      "value": false
    },
    "null_value": {
      "description": "null 값 (비어있음/존재하지 않음)",
      "example": "소문자로 null 작성",
      "value": null
    }
  },
  "structural_elements": {
    "object_example": {
      "description": "객체 (Object) - 중괄호 {} 안에 키-값(Key-Value) 쌍의 집합으로 표현됩니다.",
      "nested_property": {
        "sub_key": "서브 값",
        "depth": 2
      }
    },
    "array_of_values": {
      "description": "단순 배열 (Array of Primitives) - 대괄호 [] 안에 순서가 있는 값의 목록입니다.",
